<?xml version="1.0" encoding="utf-8"?>
<!-- Widget d'ecran d'accueil : son etat et sa batterie, mis a jour par Veille (toutes les 15 min environ) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/fond_widget">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/icone"
        android:contentDescription="Microduck" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingLeft="10dp">
        <TextView android:id="@+id/w_etat" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Microduck" android:textColor="#FF23252B" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ouvre l'appli une fois pour l'activer" android:textColor="#FFC24A08" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
