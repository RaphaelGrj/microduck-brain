<?xml version="1.0" encoding="utf-8"?>
<!-- Application Microduck pour Android : une coquille autour de l'interface que le canard sert lui-meme (appli.py).
     Elle ne parle qu'au canard, sur le reseau local, en HTTP (d'ou usesCleartextTraffic). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.microduck.appli"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Microduck"
        android:icon="@drawable/icone"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity android:name=".Accueil" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".Canard" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
