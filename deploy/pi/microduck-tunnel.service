# Tunnel SSH : expose sur le Pi le socket robotd du Microduck (/run/microduck/robotd.sock), celui du capteur de distance
# (tofd -> /run/microduck/tofd.sock) et la route camera de mediad (127.0.0.1:8080 du Pi, jamais ouverte au reseau).
# Remplace ROBOT_IP et l'utilisateur. NON TESTE sur un vrai robot. Chemin du socket tofd sur le robot : /run/tofd/tof.sock
# (lu dans le code officiel, deploy/robotd.toml et updater/src/ipc.rs, 2026-10-05).
# PREFERER deploy/robot/ : le cerveau directement SUR le canard, sans tunnel ni appareil externe.
[Unit]
Description=Tunnel SSH vers robotd (Microduck)
After=network-online.target
Wants=network-online.target

[Service]
User=microduck
RuntimeDirectory=microduck
ExecStart=/usr/bin/ssh -N \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -o StreamLocalBindUnlink=yes -o StrictHostKeyChecking=accept-new \
  -i /opt/microduck/.ssh/id_ed25519 \
  -L /run/microduck/robotd.sock:/run/robotd.sock \
  -L /run/microduck/tofd.sock:/run/tofd/tof.sock \
  -L 127.0.0.1:8080:127.0.0.1:8080 \
  microduck@ROBOT_IP
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
